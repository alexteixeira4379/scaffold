{
  "auth_verified_identities": [
    "  CONSTRAINT `fk_auth_identity_candidate` FOREIGN KEY (`candidate_id`) REFERENCES `candidates` (`id`)",
    "  PRIMARY KEY (`id`)",
    "  UNIQUE KEY `uq_auth_identity_candidate_channel` (`candidate_id`,`channel`)",
    "  UNIQUE KEY `uq_auth_identity_channel_value` (`channel`,`normalized_value`)",
    "  `candidate_id` bigint NOT NULL",
    "  `channel` enum('email','whatsapp') NOT NULL",
    "  `created_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)",
    "  `id` bigint NOT NULL AUTO_INCREMENT",
    "  `normalized_value` varchar(320) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL",
    "  `updated_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)",
    "  `verified_at` datetime(6) NOT NULL",
    ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci",
    "CREATE TABLE `auth_verified_identities` ("
  ],
  "candidate_notification_preferences": [
    "  CONSTRAINT `fk_notification_preference_candidate` FOREIGN KEY (`candidate_id`) REFERENCES `candidates` (`id`)",
    "  PRIMARY KEY (`id`)",
    "  UNIQUE KEY `uq_notification_candidate_topic_channel` (`candidate_id`,`topic`,`channel`)",
    "  `candidate_id` bigint NOT NULL",
    "  `channel` enum('email','whatsapp') NOT NULL",
    "  `created_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)",
    "  `enabled` tinyint(1) NOT NULL",
    "  `id` bigint NOT NULL AUTO_INCREMENT",
    "  `topic` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL",
    "  `updated_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)",
    ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci",
    "CREATE TABLE `candidate_notification_preferences` ("
  ],
  "job_candidate_preferences": [
    "  CONSTRAINT `fk_job_preference_candidate` FOREIGN KEY (`candidate_id`) REFERENCES `candidates` (`id`)",
    "  CONSTRAINT `fk_job_preference_job` FOREIGN KEY (`job_id`) REFERENCES `jobs` (`id`)",
    "  KEY `ix_job_preference_dismissed` (`candidate_id`,`dismissed`,`updated_at`)",
    "  KEY `ix_job_preference_job` (`job_id`)",
    "  KEY `ix_job_preference_saved` (`candidate_id`,`saved`,`updated_at`)",
    "  PRIMARY KEY (`candidate_id`,`job_id`)",
    "  `candidate_id` bigint NOT NULL",
    "  `created_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)",
    "  `dismissed` tinyint(1) NOT NULL DEFAULT '0'",
    "  `job_id` bigint NOT NULL",
    "  `saved` tinyint(1) NOT NULL DEFAULT '0'",
    "  `updated_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)",
    ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci",
    "CREATE TABLE `job_candidate_preferences` ("
  ],
  "candidate_preferences": [
    "  CONSTRAINT `fk_candidate_preferences_candidate_id_candidates` FOREIGN KEY (`candidate_id`) REFERENCES `candidates` (`id`)",
    "  PRIMARY KEY (`id`)",
    "  UNIQUE KEY `uq_candidate_preferences_candidate_id` (`candidate_id`)",
    "  `candidate_id` bigint NOT NULL",
    "  `created_at` datetime NOT NULL DEFAULT (now())",
    "  `currency` varchar(3) DEFAULT NULL",
    "  `employment_preference` enum('unknown','full_time','part_time','contract','internship','temporary','freelancer') NOT NULL DEFAULT 'unknown'",
    "  `experience_level` enum('unknown','intern','junior','mid','mid_senior','senior','staff','principal','lead','executive') NOT NULL DEFAULT 'unknown'",
    "  `id` bigint NOT NULL AUTO_INCREMENT",
    "  `min_salary` decimal(12,2) DEFAULT NULL",
    "  `notes` text",
    "  `remote_preference` enum('unknown','remote','hybrid','onsite','flexible') NOT NULL DEFAULT 'unknown'",
    "  `reviewed_at` datetime(6) DEFAULT NULL",
    "  `target_country` varchar(2) DEFAULT NULL",
    "  `target_location` text",
    "  `updated_at` datetime NOT NULL DEFAULT (now())",
    ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci",
    "CREATE TABLE `candidate_preferences` ("
  ],
  "candidate_target_profiles": [
    "  CONSTRAINT `fk_candidate_target_profiles_candidate_id_candidates` FOREIGN KEY (`candidate_id`) REFERENCES `candidates` (`id`)",
    "  KEY `ix_candidate_target_profiles_candidate_active` (`candidate_id`,`active`)",
    "  KEY `ix_candidate_target_profiles_candidate_is_default` (`candidate_id`,`is_default`)",
    "  KEY `ix_target_candidate_archived` (`candidate_id`,`archived_at`)",
    "  PRIMARY KEY (`id`)",
    "  UNIQUE KEY `uq_target_candidate_id` (`candidate_id`,`id`)",
    "  `active` tinyint(1) NOT NULL DEFAULT '1'",
    "  `archived_at` datetime(6) DEFAULT NULL",
    "  `automation_authorized` tinyint(1) NOT NULL DEFAULT '0'",
    "  `candidate_id` bigint NOT NULL",
    "  `created_at` datetime NOT NULL DEFAULT (now())",
    "  `currency` varchar(3) DEFAULT NULL",
    "  `employment_preference` enum('unknown','full_time','part_time','contract','internship','temporary','freelancer') NOT NULL DEFAULT 'unknown'",
    "  `experience_level` enum('unknown','intern','junior','mid','mid_senior','senior','staff','principal','lead','executive') NOT NULL DEFAULT 'unknown'",
    "  `id` bigint NOT NULL AUTO_INCREMENT",
    "  `is_default` tinyint(1) NOT NULL DEFAULT '0'",
    "  `min_salary` decimal(12,2) DEFAULT NULL",
    "  `name` text NOT NULL",
    "  `notes` text",
    "  `remote_preference` enum('unknown','remote','hybrid','onsite','flexible') NOT NULL DEFAULT 'unknown'",
    "  `target_country` varchar(2) DEFAULT NULL",
    "  `target_location` text",
    "  `updated_at` datetime NOT NULL DEFAULT (now())",
    ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci",
    "CREATE TABLE `candidate_target_profiles` ("
  ],
  "resume_personas": [
    "  CONSTRAINT `ck_persona_content_object` CHECK ((json_type(`content`) = _utf8mb4'OBJECT'))",
    "  CONSTRAINT `ck_persona_revision` CHECK ((`revision` >= 1))",
    "  CONSTRAINT `fk_persona_candidate` FOREIGN KEY (`candidate_id`) REFERENCES `candidates` (`id`)",
    "  CONSTRAINT `fk_persona_owned_target` FOREIGN KEY (`candidate_id`, `target_profile_id`) REFERENCES `candidate_target_profiles` (`candidate_id`, `id`)",
    "  KEY `ix_persona_candidate_target` (`candidate_id`,`target_profile_id`)",
    "  PRIMARY KEY (`id`)",
    "  UNIQUE KEY `uq_resume_persona_target` (`target_profile_id`)",
    "  `candidate_id` bigint NOT NULL",
    "  `content` json NOT NULL",
    "  `created_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)",
    "  `enabled` tinyint(1) NOT NULL DEFAULT '0'",
    "  `id` bigint NOT NULL AUTO_INCREMENT",
    "  `revision` bigint unsigned NOT NULL DEFAULT '1'",
    "  `source_updated_at` datetime(6) DEFAULT NULL",
    "  `target_profile_id` bigint NOT NULL",
    "  `updated_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)",
    ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci",
    "CREATE TABLE `resume_personas` ("
  ],
  "resume_profiles": [
    "  CONSTRAINT `ck_resume_reviewed_array` CHECK (((`reviewed_sections` is null) or (json_type(`reviewed_sections`) = _utf8mb4'ARRAY')))",
    "  CONSTRAINT `ck_resume_revision` CHECK ((`revision` >= 1))",
    "  CONSTRAINT `fk_resume_profiles_candidate_id_candidates` FOREIGN KEY (`candidate_id`) REFERENCES `candidates` (`id`)",
    "  PRIMARY KEY (`id`)",
    "  UNIQUE KEY `uq_resume_profiles_candidate_id` (`candidate_id`)",
    "  `candidate_id` bigint NOT NULL",
    "  `created_at` datetime NOT NULL DEFAULT (now())",
    "  `headline` varchar(255) DEFAULT NULL",
    "  `id` bigint NOT NULL AUTO_INCREMENT",
    "  `portfolio_url` text",
    "  `reviewed_sections` json DEFAULT NULL",
    "  `revision` bigint unsigned NOT NULL DEFAULT '1'",
    "  `schema_version` int NOT NULL DEFAULT '1'",
    "  `source` enum('workflow','direct_api') NOT NULL",
    "  `summary` text",
    "  `updated_at` datetime NOT NULL DEFAULT (now())",
    ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci",
    "CREATE TABLE `resume_profiles` ("
  ],
  "resume_versions": [
    "  CONSTRAINT `fk_resume_owned_target` FOREIGN KEY (`candidate_id`, `target_profile_id`) REFERENCES `candidate_target_profiles` (`candidate_id`, `id`)",
    "  CONSTRAINT `fk_resume_versions_candidate_id_candidates` FOREIGN KEY (`candidate_id`) REFERENCES `candidates` (`id`)",
    "  CONSTRAINT `fk_resume_versions_session_id_resume_build_sessions` FOREIGN KEY (`session_id`) REFERENCES `resume_build_sessions` (`id`)",
    "  KEY `ix_resume_owned_target` (`candidate_id`,`target_profile_id`)",
    "  KEY `ix_resume_session` (`session_id`)",
    "  KEY `ix_resume_versions_candidate_id` (`candidate_id`)",
    "  KEY `ix_resume_versions_candidate_is_current` (`candidate_id`,`is_current`)",
    "  PRIMARY KEY (`id`)",
    "  UNIQUE KEY `uq_resume_current_scope` (`candidate_id`,`current_scope`)",
    "  `archived_at` datetime(6) DEFAULT NULL",
    "  `candidate_id` bigint NOT NULL",
    "  `content` text",
    "  `created_at` datetime NOT NULL DEFAULT (now())",
    "  `current_scope` bigint GENERATED ALWAYS AS ((case when ((`is_current` = 1) and (`archived_at` is null)) then coalesce(`target_profile_id`,0) else NULL end)) STORED",
    "  `format` enum('pdf','html','docx','txt','rtf','md') NOT NULL DEFAULT 'pdf'",
    "  `id` bigint NOT NULL AUTO_INCREMENT",
    "  `is_current` tinyint(1) NOT NULL DEFAULT '0'",
    "  `session_id` bigint DEFAULT NULL",
    "  `storage_url` text",
    "  `target_profile_id` bigint DEFAULT NULL",
    "  `updated_at` datetime NOT NULL DEFAULT (now())",
    "  `version_number` int NOT NULL DEFAULT '1'",
    ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci",
    "CREATE TABLE `resume_versions` ("
  ]
}
